<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>BoringSetupProtocolVersion</key><integer>1</integer>
    <key>BoringSetupUIVersion</key><integer>1</integer>
    <key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleURLName</key><string>theboringteam.boringnotch.setup</string>
        <key>CFBundleURLSchemes</key><array><string>boringnotch-setup</string></array>
    </dict></array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_kdeconnect._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>boringNotch discovers paired LocalSend and KDE Connect devices on your local network to send Shelf items.</string>
	<!--
	  The call copilot captures through CallaCallHost, which carries its own
	  copies of these strings. They are needed here as well: TCC attributes a
	  request to the *responsible* process, and for a helper spawned by our XPC
	  service that is boringNotch. Without them the host is killed outright —
	  "This app has crashed because it attempted to access privacy-sensitive
	  data without a usage description" — the moment it asks for a microphone.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>The call copilot transcribes your side of a call on this Mac to suggest how to answer. Audio never leaves your Mac.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Call Copilot captures system audio. Screen Quiz captures only your selected window and sends screenshots plus selected context through local AGY to the remote model sessions you configure, with a possible arbiter and one fresh automatic retry for failed requests. Independent web research may occur. Quiz captures stay encrypted until you delete them. Quiz never clicks, types, or submits.</string>
	<key>SUEnableDownloaderService</key>
	<true/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUPublicEDKey</key>
	<string>B1Y47t8C/v8ImurYA+9arEsuCrpxwJSviekiflMElbI=</string>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict/>
	</array>
</dict>
</plist>
