# Copy to .env (chmod 600). Never commit .env.
POSTGRES_PASSWORD=change-me
CALLA_UID=1000
CALLA_GID=1000
# The vault: every call, the thing to back up. On the NAS (NFS 4.1 hard
# mount). The backend refuses to start if the NAS is not mounted.
CALLA_VAULT_DIR=/mnt/nas/data/calla
CALLA_PUBLIC_URL=https://calla-api.nomonlab.com
# Macs enroll themselves over POST /v1/enroll with this; deploy.sh generates it
# and copies it to ~/.config/calla/enroll-secret for scripts/package-private.sh.
CALLA_ENROLL_SECRET=
# Refuse uploads when free disk would drop below this (bytes). 5 GiB:
CALLA_MIN_FREE=5368709120
